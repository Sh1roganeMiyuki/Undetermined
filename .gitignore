# ------------------------------------------------------------------
# 仓库根 ignore。
# guance-archive/ 内部另有自己的 .gitignore（node_modules / .next / out /
# site.pak / runtime 等），此处只管根目录与体验包目录里的交付产物。
# ------------------------------------------------------------------

# 交付物：zip 与 pak 都能由仓库内源码重建（npm run build && npm run pack），
# 入库只会让仓库背上 14MB+ 的二进制，且每次发版产生无意义的大 diff。
/城北新区资料协作平台-体验包.zip
/城北新区资料协作平台-体验包/site.pak

# 便携 Node 运行时：首启脚本自动准备，不入库（体验包 README 口径）
/城北新区资料协作平台-体验包/runtime/

# 本地伺服的调试日志
/城北新区资料协作平台-体验包/pkg-serve.log
/城北新区资料协作平台-体验包/pkg-serve.err

# 评审/核验截图：过程产物，不是源码。需要留档时单独建 docs/shots/ 提交。
/*.png

# 打包中转目录
/.zipstage/

# 系统与编辑器杂物
.DS_Store
Thumbs.db
desktop.ini
